{
  "name": "@blockrun/clawrouter-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "One-click ClawRouter control plane for OpenClaw, Codex, Hermes, DeepSeek Harness, and Pi",
  "author": "BlockRun <hello@blockrun.ai>",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --out-extension:.js=.cjs",
    "build:icon": "electron scripts/render-icon.cjs",
    "build": "npm run build:renderer && npm run build:electron",
    "stage:runtime": "corepack pnpm install --dir runtime --prod --frozen-lockfile",
    "start": "electron .",
    "dist": "npm run stage:runtime && npm run verify:runtime && npm run build && npm run build:icon && electron-builder --mac dir",
    "dist:release": "npm run stage:runtime && npm run verify:runtime && npm run build && npm run build:icon && electron-builder --mac zip",
    "verify:runtime": "node scripts/verify-runtime-pin.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip39": "1.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "typescript": "7.0.2",
    "vite": "8.2.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "fast-uri": "3.1.9",
    "source-map-js": "1.2.2",
    "undici@6": "6.29.1",
    "undici@7": "7.30.1",
    "minimatch@9": "11.0.5",
    "minimatch@10": "11.0.5"
  },
  "engines": {
    "node": ">=22.19"
  },
  "build": {
    "appId": "ai.blockrun.clawrouter.desktop",
    "productName": "ClawRouter",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml"
        ]
      },
      {
        "from": "runtime/node_modules",
        "to": "runtime/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
