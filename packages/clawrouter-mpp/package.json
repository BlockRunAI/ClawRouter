{
  "name": "@twzrd1111/clawrouter-mpp",
  "version": "0.2.0",
  "description": "MPP (Machine Payments Protocol) payment rails for ClawRouter: Tempo and Solana charge, with spend limits and paid-failure handling",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twzrd-sol/ClawRouter-1.git",
    "directory": "packages/clawrouter-mpp"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@twzrd1111/clawrouter": ">=0.12.307",
    "@solana/kit": "~6.10.0",
    "@solana/mpp": "~0.7.0",
    "mppx": "~0.17.0",
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@solana/kit": {
      "optional": true
    },
    "@solana/mpp": {
      "optional": true
    },
    "mppx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solana/kit": "6.10.0",
    "@solana/mpp": "0.7.0",
    "@solana/pay-kit": "0.13.1",
    "mppx": "0.17.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
